# development | production  (production turns on HTTPS-only cookies and HSTS)
APP_ENV=development

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=masterkey

# Docker Compose database. Use letters and numbers only in the password.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=g8keeper
POSTGRES_DB=learnhub_db

# Only needed when running without Docker (uvicorn directly). Docker Compose builds its own.
# DATABASE_URL=postgresql+psycopg://postgres:g8keeper@localhost:5433/learnhub_db
